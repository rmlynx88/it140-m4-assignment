START hilow_game

    // Declare variables
    DECLARE lowerBound AS INTEGER
    DECLARE upperBound AS INTEGER
    DECLARE secretNumber AS INTEGER
    DECLARE guess AS INTEGER

    // Welcome message
    DISPLAY "Welcome to the higher/lower game, Bella!"

    // Obtain and validate bounds
    DISPLAY "Enter the lower bound: "
    INPUT lowerBound
    DISPLAY "Enter the upper bound: "
    INPUT upperBound

    WHILE upperBound <= lowerBound
        DISPLAY "The lower bound must be less than the upper bound."
        DISPLAY "Enter the lower bound: "
        INPUT lowerBound
        DISPLAY "Enter the upper bound: "
        INPUT upperBound
    ENDWHILE

    // Generate random number
    SET secretNumber = RANDOM(lowerBound, upperBound)

    DISPLAY "Great, now guess a number between ", lowerBound, " and ", upperBound, ": "
    INPUT guess

    // Play the game loop
    WHILE guess != secretNumber
        IF guess < secretNumber THEN
            DISPLAY "Nope, too low."
        ELSE
            DISPLAY "Nope, too high."
        ENDIF
        
        DISPLAY "Guess another number: "
        INPUT guess
    ENDWHILE

    DISPLAY "You got it!"

END hilow_game
